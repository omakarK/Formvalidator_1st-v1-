# Environment variables for the Form Validator
# Copy this to .env and customize as needed

# Server
FV_HOST=0.0.0.0
FV_PORT=9000
FV_DEBUG=false

# Concurrency
# FV_MAX_WORKERS=8
# FV_UVICORN_WORKERS=4

# Thresholds (tune for your forms)
# FV_TEMPLATE_MATCH_THRESHOLD=0.35
# FV_PHOTO_MIN_FACE_CONFIDENCE=0.50
# FV_SIGNATURE_MIN_STROKE_DENSITY=0.005

# Logging
FV_LOG_LEVEL=INFO
FV_LOG_JSON=true

# Redis (optional)
# FV_REDIS_URL=redis://localhost:6379/0

# Upload limits
FV_MAX_UPLOAD_SIZE_MB=20
